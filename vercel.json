{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build -w @play/shared && npm run build -w @play/api && npm run build -w @play/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "fixtures/listing.json"
    }
  }
}
